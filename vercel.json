{
  "version": 2,
  "builds": [
    {
      "src": "backend/api.py",
      "use": "@vercel/python",
      "config": {
        "entrypoint": "backend.api:app"
      }
    }
  ],
  "routes": [
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "backend/api.py"
    }
  ],
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "true",
  "devCommand": "python3 run.py"
}